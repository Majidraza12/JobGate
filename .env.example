# Copy to .env (gitignored) and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Contact info appended to the honest User-Agent, e.g. an email or repo URL.
JOBGATE_CONTACT=
# Hard daily spend cap for extraction, in USD.
EXTRACT_DAILY_CAP_USD=1

# --- Hosted Supabase (Project Settings > API, and Connect > Session pooler) ---
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or legacy service_role key. SECRET: server only.
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler connection string, with your DB password filled in.
# Deliberately not named DATABASE_URL: the pipeline and tests read DATABASE_URL,
# and they must keep hitting local Supabase, never the hosted one.
HOSTED_DATABASE_URL=
